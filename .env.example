POSTGRES_DB=mototrack
POSTGRES_USER=mototrack
POSTGRES_PASSWORD=mototrack123

DB_URL=jdbc:postgresql://localhost:5432/mototrack
DB_USER=mototrack
DB_PASSWORD=mototrack123

# Generate with: openssl rand -base64 48
JWT_SECRET=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# E-mail (códigos de recuperação de senha e troca de e-mail).
# Em desenvolvimento o padrão aponta para o Mailpit (docker compose up -d).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=MotoTrack <nao-responda@mototrack.local>

# Produção: a plataforma define PORT. Atrás do proxy dela, ligue isto para o limite de
# requisições por IP enxergar o IP real do usuário (veja o README, "Publicando em produção").
TRUST_FORWARDED_FOR=false
RATE_LIMIT_ENABLED=true
